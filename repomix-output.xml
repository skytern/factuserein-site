  background: var(--bleu);
  color: #fff;
  position: sticky; top: 0; z-index: 50;
  box-shadow: 0 2px 8px rgba(0,0,0,.18);
}
.site-header .container {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding-top: 12px; padding-bottom: 12px;
}
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; font-weight: 700; font-size: 20px; }
.brand .logo {
  width: 30px; height: 30px; border-radius: 6px; display: block;
}
.main-nav { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
.main-nav a { color: #dbeafe; text-decoration: none; font-size: 15px; }
.main-nav a:hover { color: #fff; text-decoration: underline; }
.main-nav .cta { background: var(--vert); color: #fff; padding: 8px 16px; border-radius: 8px; font-weight: 600; }
.main-nav .cta:hover { background: var(--vert-fonce); text-decoration: none; }

.menu-toggle { display: none; background: none; border: 0; color: #fff; font-size: 26px; cursor: pointer; }

/* ---------- Hero ---------- */
.hero {
  background: linear-gradient(135deg, #f0fdf4 0%, #eff6ff 58%, #ffffff 100%);
  color: var(--texte); padding: 72px 0 64px;
}
.hero .container { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
.hero h1 { font-size: 42px; line-height: 1.15; margin: 16px 0; color: var(--bleu-fonce); letter-spacing: -.5px; }
.hero p.lead { font-size: 18px; color: var(--texte-doux); margin-bottom: 24px; max-width: 620px; }
.badge-urgence {
  display: inline-block; background: #ecfdf5; color: #166534;
  border: 1px solid #bbf7d0; padding: 6px 14px; border-radius: 999px;
  font-size: 14px; font-weight: 600;
}
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
.btn {
  display: inline-block; padding: 12px 24px; border-radius: 10px; text-decoration: none;
  font-weight: 600; font-size: 16px; border: 0; cursor: pointer; text-align: center;
}
.btn-vert { background: var(--vert); color: #fff; }
.btn-vert:hover { background: var(--vert-fonce); }
.btn-blanc { background: #fff; color: var(--bleu); }
.btn-blanc:hover { background: #eef2ff; }
.btn-outline { background: transparent; color: var(--bleu); border: 2px solid var(--bleu); }
.btn-outline:hover { background: #eef2ff; }

.hero-confiance {
  background: rgba(255,255,255,.92); border: 1px solid #dbeafe; border-radius: 20px;
  padding: 30px; box-shadow: 0 14px 36px rgba(15,37,87,.10);
}
.hero-confiance-icon {
  width: 54px; height: 54px; display: grid; place-items: center;
  border-radius: 16px; background: var(--vert); color: #fff;
  font-size: 30px; font-weight: 800; margin-bottom: 18px;
}
.hero-confiance-label { color: var(--vert-fonce); font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
.hero-confiance h2 { color: var(--bleu); font-size: 24px; line-height: 1.25; margin: 8px 0; }
.hero-confiance > p:not(.hero-confiance-label) { color: var(--texte-doux); }
.hero-confiance-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
.hero-confiance-tags span { background: #f1f5f9; color: var(--bleu); border-radius: 999px; padding: 6px 10px; font-size: 13px; font-weight: 600; }

.trust-strip { background: #fff; border-bottom: 1px solid var(--bordure); }
.trust-strip .container { display: flex; justify-content: center; gap: 34px; flex-wrap: wrap; padding-top: 16px; padding-bottom: 16px; color: var(--bleu); font-size: 14px; font-weight: 700; }

.ok { color: var(--vert); font-weight: 700; }

/* ---------- Sections ---------- */
.section { padding: 64px 0; }
.section.alt { background: #fff; border-top: 1px solid var(--bordure); border-bottom: 1px solid var(--bordure); }
.section h2 { font-size: 30px; color: var(--bleu); margin-bottom: 12px; }
.section .sous-titre { color: var(--texte-doux); max-width: 720px; margin-bottom: 36px; }

.grille { display: grid; gap: 20px; }
.grille-3 { grid-template-columns: repeat(3, 1fr); }
.grille-2 { grid-template-columns: repeat(2, 1fr); }
.carte {
  background: var(--carte); border: 1px solid var(--bordure); border-radius: var(--radius);
  padding: 24px; box-shadow: var(--ombre);
}
.carte h3 { color: var(--bleu); margin-bottom: 8px; font-size: 18px; }
.carte .num {
  width: 34px; height: 34px; border-radius: 50%; background: var(--bleu); color: #fff;
  display: flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 12px;
}
.carte ul { list-style: none; margin-top: 8px; }
.carte li { padding: 4px 0 4px 22px; position: relative; }
.carte li::before { content: "âœ“"; color: var(--vert); font-weight: 700; position: absolute; left: 0; }
.carte li.non::before { content: "âœ—"; color: var(--rouge); }

/* ---------- Tarifs ---------- */
.prix { font-size: 40px; font-weight: 800; color: var(--bleu); margin: 8px 0 4px; }
.prix span { font-size: 16px; font-weight: 400; color: var(--texte-doux); }
.carte.mise-en-avant { border: 2px solid var(--vert); position: relative; }
.etiquette {
  position: absolute; top: -14px; left: 20px; background: var(--vert); color: #fff;
  padding: 4px 14px; border-radius: 999px; font-size: 13px; font-weight: 600;
}
.entretien { font-size: 13px; color: var(--texte-doux); }

/* ---------- Tableaux ---------- */
table { width: 100%; border-collapse: collapse; background: var(--carte); border-radius: var(--radius); overflow: hidden; box-shadow: var(--ombre); }
th, td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--bordure); font-size: 15px; }
th { background: var(--bleu); color: #fff; font-weight: 600; }
tr:last-child td { border-bottom: 0; }
td.ok { color: var(--vert); font-weight: 600; }
td.non { color: var(--rouge); }

/* ---------- FAQ ---------- */
.faq details { background: var(--carte); border: 1px solid var(--bordure); border-radius: 10px; margin-bottom: 10px; padding: 16px 20px; }
.faq summary { font-weight: 600; cursor: pointer; color: var(--bleu); }
.faq details p { margin-top: 10px; color: var(--texte-doux); }

/* ---------- CTA final ---------- */
.cta-final { background: linear-gradient(135deg, var(--vert-fonce), var(--vert)); color: #fff; text-align: center; padding: 56px 20px; border-radius: 16px; }
.cta-final h2 { color: #fff; font-size: 30px; margin-bottom: 12px; }
.cta-final p { margin-bottom: 24px; max-width: 600px; margin-left: auto; margin-right: auto; }

/* ---------- Footer ---------- */
.site-footer { background: var(--bleu-fonce); color: #cbd5e1; padding: 40px 0 24px; font-size: 14px; }
.site-footer .container { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 32px; }
.site-footer h4 { color: #fff; margin-bottom: 10px; }
.site-footer a { color: #93c5fd; text-decoration: none; display: block; margin-bottom: 6px; }
.site-footer a:hover { text-decoration: underline; }
.site-footer .mentions { grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,.12); padding-top: 16px; text-align: center; color: #94a3b8; }

/* ---------- Pages internes ---------- */
.page-titre { background: var(--bleu); color: #fff; padding: 48px 0 40px; }
.page-titre h1 { font-size: 34px; margin-bottom: 8px; }
.page-titre p { color: #dbeafe; max-width: 720px; }

.marge { margin-top: 24px; }
.encart {
  background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 16px 20px;
  margin: 20px 0; font-size: 15px;
}
.encart.vert { background: #f0fdf4; border-color: #bbf7d0; }
.encart.rouge { background: #fef2f2; border-color: #fecaca; }
.puce-erreur { color: var(--rouge); font-weight: 600; }

/* ---------- Formulaire ---------- */
form label { display: block; font-weight: 600; margin: 14px 0 4px; }
form input, form select, form textarea {
  width: 100%; padding: 10px 12px; border: 1px solid var(--bordure); border-radius: 8px;
  font-size: 15px; font-family: inherit; background: #fff;
}
form input:focus, form select:focus, form textarea:focus { outline: 2px solid var(--vert); border-color: transparent; }

.zone-depot {
  border: 2px dashed #94a3b8; border-radius: var(--radius); padding: 48px 20px;
  text-align: center; background: #fff; cursor: pointer; transition: border-color .2s;
}
.zone-depot:hover { border-color: var(--vert); }
.zone-depot .gros { font-size: 40px; margin-bottom: 8px; }

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .hero .container { grid-template-columns: 1fr; }
  .hero h1 { font-size: 32px; }
  .grille-3 { grid-template-columns: 1fr; }
  .grille-2 { grid-template-columns: 1fr; }
  .site-footer .container { grid-template-columns: 1fr; }
  .menu-toggle { display: block; }
  .main-nav {
    display: none; width: 100%; flex-direction: column; align-items: flex-start;
    padding: 8px 0 16px; gap: 10px;
  }
  .main-nav.ouvert { display: flex; }
  .trust-strip .container { justify-content: flex-start; gap: 10px 20px; }
}

/* ---------- Illustrations ---------- */
.illu { width: 100%; height: auto; border-radius: 12px; display: block; margin-bottom: 14px; }
.illu-hero { max-width: 420px; margin: 0 auto 16px; width: 100%; height: auto; border-radius: 12px; }
.illu-banniere { width: 100%; max-height: 300px; object-fit: cover; border-radius: 12px; margin: 18px 0 6px; }
.illu-carte { max-width: 260px; margin: 0 auto 12px; width: 100%; height: auto; border-radius: 10px; }
.illu-securite { max-width: 340px; margin: 14px auto 0; width: 100%; height: auto; border-radius: 12px; }

/* Logo officiel facturation électronique (réforme DGFiP) */
.logo-officiel { max-width: 210px; height: auto; display: block; margin: 12px auto 0; }
</file>

